# Runtime state (per-host, regenerated by tests / orchestrator runs)
.dev/state/domain/

# Sandbox runtime + capture-time state (T-B-018 / T-B-019 / T-B-020 /
# T-B-021). Per-host, regenerated by the agent runtime and by
# `python -m agent.scripts.capture_money_shot`. Should NEVER land in git.
state/

# Claude Code local cache (per-host, regenerated automatically)
.claude/settings.local.json

# Secrets (never commit)
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/
wallet*.json
attestation_key.enc

