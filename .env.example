# Autopoiesis — environment variable template
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# LLM POLICY (memory: feedback_no_external_llm_api.md):
#   - Development tooling (orchestrator subagents writing code, advisors,
#     reviewers, doc-editor) → Claude Code internal via
#     harness/claude_client.spawn_*. NO API key needed (uses Claude Code login).
#   - Production runtime (deployed Autopoiesis agent's sentiment/reflection
#     engines) → Gemini 3.1 Flash Lite via google-genai SDK + AI Studio.
#     Configure GEMINI_API_KEY below.
#   - FORBIDDEN in either layer: ANTHROPIC_API_KEY, OPENAI_API_KEY.
#   - APPROVED fallback: MiniMax (OpenAI-compatible, NOT Anthropic/OpenAI) may
#     back the production Gemini seam as a failover. OFF by default — set
#     MINIMAX_API_KEY below to enable the Gemini->MiniMax fallback chain.

# =============================================================================
# Production LLM — Gemini 3.1 Flash Lite via Google AI Studio
# =============================================================================

# Used by agent/llm/gemini_client.py (sprint_4 T-B-006) to wrap the
# google-genai SDK for SentimentLLMEngine + ReflectionEngine production calls.
# Get a key: https://aistudio.google.com/apikey (free tier is generous enough
# for hackathon dev iteration; production pays per-call).
# Model id: gemini-3.1-flash-lite
GEMINI_API_KEY=

# =============================================================================
# MiniMax — production LLM FALLBACK for Gemini (OFF by default)
# =============================================================================

# User-approved failover provider. MiniMax is OpenAI-compatible but is NOT
# Anthropic/OpenAI, so it does not violate the no-Anthropic/no-OpenAI policy.
# Wiring: agent/llm/factory.py::make_llm_client() returns a plain GeminiClient
# UNLESS MINIMAX_API_KEY is set/non-empty, in which case it returns a
# FallbackLLMClient(primary=GeminiClient, fallback=MiniMaxClient). Leave
# MINIMAX_API_KEY blank to keep the deployment Gemini-only (byte-unchanged).
# Get a key: https://www.minimax.io/ (international platform).
MINIMAX_API_KEY=
# OpenAI-compatible base URL. International default below; the domestic
# platform is https://api.minimaxi.com/v1 (differs only by host).
MINIMAX_BASE_URL=https://api.minimax.io/v1
# Default model when the per-call model arg is empty.
MINIMAX_MODEL=MiniMax-M3
# Optional — only the domestic native path needs a GroupId; harmless if unset.
# MINIMAX_GROUP_ID=

# =============================================================================
# Chain RPC endpoints — 3-chain parallel deployment (Plan v3)
# =============================================================================

# Robinhood Chain testnet (primary deployment; sponsor synergy + top-3 reserved spot)
# Get URL from: https://docs.chain.robinhood.com
ROBINHOOD_CHAIN_RPC=

# Arbitrum Sepolia L2 (hot fallback; deploys same .sol in parallel)
# Public endpoint or Alchemy/Infura URL
SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Polygon Amoy testnet (3rd deployment for Polygon ecosystem category)
# Public endpoint or Alchemy/Infura URL
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# Polygon mainnet RPC (READ-ONLY: Track E indexer for Smart Money α₃ signal
# + Polymarket on-chain swap events; NEVER used to send transactions)
POLYGON_RPC_URL=

# =============================================================================
# IPFS pinning service (Tombstone NFT memoryBankCid)
# =============================================================================

# Pinata API credentials (1GB free tier is plenty for hackathon)
# Sign up: https://pinata.cloud
PINATA_API_KEY=
PINATA_SECRET_KEY=

# =============================================================================
# Deployer wallet (testnet only — NEVER use a mainnet key)
# =============================================================================

# Private key for deploying contracts to RH Chain + Sepolia + Polygon Amoy.
# Use a fresh wallet just for testnet. All 3 chains can share one key
# (they're separate chainIds; no replay risk).
# Fund via each chain's faucet.
DEPLOYER_PRIVATE_KEY=

# =============================================================================
# Stage-2 mock-bet — live paper-trading loop + dashboard /mock (plan-loop V1.2–V1.5)
# =============================================================================
#
# The agent paper-trades LIVE Polymarket tennis (no capital at risk). All flags are
# OFF by default → the prod loop keeps its existing replay-if-cassettes-else-idle
# behaviour, byte-unchanged. Turn them on TOGETHER for a live run.

# V1.3 — explicit LIVE mode switch. SANDBOX_LIVE=1 ⇒ the loop wires the real
# open-market discovery (gamma /events?closed=false) + real gamma settlement +
# RealSignalSource over a live CLOB price ledger, and NEVER constructs the
# replay/synthetic path (mutually exclusive). Unset/≠1 ⇒ existing default.
SANDBOX_LIVE=

# Settlement-time self-learning (能学). GENESIS_REAL_LEARNING=1 swaps the real
# WeightUpdater onto the settlement poller so realized PnL updates the 6 fusion
# weights across lives. Unset ⇒ inert (frozen-config smoke stays byte-unchanged).
GENESIS_REAL_LEARNING=

# Real per-tick signals. GENESIS_REAL_SIGNALS=1 ⇒ the 5 Sackmann/CLOB baseline
# signals (real momentum + the 4 facets on resolvable slugs); unset ⇒ the
# deterministic synthetic signal source. The LIVE loop sets this implicitly.
GENESIS_REAL_SIGNALS=

# State dir the loop writes its JSONL ledgers to AND the dashboard /api/sandbox
# route reads from (dashboard/lib/load_sandbox_state.server.ts::resolveSandboxRoot
# honours this override; default <repoRoot>/state/sandbox). Point both at the same
# dir so /mock renders the live loop's open/settled/decisions JSONL via 2s file-poll.
SANDBOX_STATE_DIR=

# Dashboard L5 gate (build-time, NEXT_PUBLIC_ so the client bundle sees it). Set to
# 1 to UNLOCK the /mock survival-journey route; until then /mock fails closed to a
# locked placeholder. Read by dashboard/lib/l5_gate.ts::readL5Complete.
NEXT_PUBLIC_L5_COMPLETE=

# =============================================================================
# Optional / future
# =============================================================================

# Open House London registration confirmation (paste your team's confirmation
# email URL or ID for audit-trail purposes)
HACKATHON_REGISTRATION_REF=
